{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eacp.dev/schemas/v1alpha1/mcp-tool-chart-values.schema.json",
  "title": "mcp-tool chart values",
  "description": "GENERATED by scripts/sync-chart-schema.py from schemas/tool-manifest.schema.json plus the platform block. Do not edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "platform"
  ],
  "properties": {
    "apiVersion": {
      "const": "eacp.dev/v1alpha1"
    },
    "kind": {
      "const": "ToolManifest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "team",
        "owner"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/dnsLabel",
          "description": "Server name. Also the Kubernetes resource name and the tool-name prefix in the virtual MCP endpoint."
        },
        "team": {
          "$ref": "#/$defs/dnsLabel",
          "description": "Owning team. Must exist under teams/<team>/manifest.yaml. Determines the namespace team-<team>."
        },
        "owner": {
          "type": "string",
          "format": "email",
          "description": "Accountable human or distribution list."
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "transport",
        "credentials",
        "tools",
        "pins"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9.\\-/_:]+@sha256:[a-f0-9]{64}$",
          "description": "Container image pinned by digest. Tags are rejected. The tool gate verifies the cosign signature and scans the image."
        },
        "transport": {
          "enum": [
            "http",
            "stdio"
          ],
          "description": "http: the server speaks Streamable HTTP itself and runs as a Deployment. stdio: the server is wrapped by a kmcp MCPServer with the transport adapter sidecar."
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/",
              "default": "/mcp"
            }
          }
        },
        "stdio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmd"
          ],
          "properties": {
            "cmd": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "description": "Plain environment variables. Secrets never go here; use credentials.secretRef."
        },
        "egress": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/egressRule"
          },
          "description": "Egress allow-list. Everything not listed is denied by the rendered NetworkPolicy. DNS to kube-dns is always allowed. fqdn rules are enforced only when the cluster provides FQDN-aware policies (Cilium); otherwise CI warns."
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "service",
                "delegated"
              ],
              "description": "none: the server needs no downstream credential. service: a shared credential from the secrets manager, delivered as environment variables. delegated: the gateway exchanges the caller's token for a downstream token so the backend sees the real user."
            },
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "store": {
                  "type": "string",
                  "default": "openbao",
                  "description": "ClusterSecretStore name."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Path in the secrets manager, for example eacp/tools/customer-db."
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]*$"
                  },
                  "uniqueItems": true,
                  "description": "Keys to expose as environment variables. Empty means all keys at the path."
                }
              }
            },
            "delegated": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "audience"
              ],
              "properties": {
                "audience": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Audience requested in the RFC 8693 token exchange."
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "service"
                  }
                }
              },
              "then": {
                "required": [
                  "secretRef"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "delegated"
                  }
                }
              },
              "then": {
                "required": [
                  "delegated"
                ]
              }
            }
          ]
        },
        "requiredGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": [],
          "description": "Identity groups entitled to see and call this server. Empty means every authenticated caller whose agent manifest allows the tool."
        },
        "outputTrust": {
          "enum": [
            "trusted",
            "untrusted"
          ],
          "default": "trusted",
          "description": "untrusted: results may contain third-party content such as web pages or inbound email. They taint the conversation and are always screened for injection."
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tool"
          },
          "description": "Every tool the server exposes. A tool not listed here is denied even if the server advertises it."
        },
        "pins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tools",
            "prompts",
            "resources"
          ],
          "properties": {
            "tools": {
              "$ref": "#/$defs/pin"
            },
            "prompts": {
              "$ref": "#/$defs/pin"
            },
            "resources": {
              "$ref": "#/$defs/pin"
            }
          },
          "description": "SHA-256 of the canonical JSON of the server's tools/list, prompts/list and resources/list results, computed by scripts/pin-tools.py at onboarding. The adapter quarantines the server when a live listing no longer matches."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "$ref": "#/$defs/resourceList"
            },
            "limits": {
              "$ref": "#/$defs/resourceList"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "http"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "stdio"
              }
            }
          },
          "then": {
            "required": [
              "stdio"
            ]
          }
        }
      ]
    },
    "platform": {
      "type": "object",
      "description": "Platform wiring supplied by platform/values/<profile>.yaml, never by a tool manifest.",
      "required": [
        "gateway",
        "adapter",
        "keycloak",
        "secrets",
        "kmcp",
        "networkPolicy",
        "podSecurity"
      ],
      "properties": {
        "profile": {
          "enum": [
            "laptop",
            "cloud-gpu"
          ]
        },
        "namespaceOverride": {
          "type": "string"
        },
        "gateway": {
          "type": "object",
          "required": [
            "name",
            "namespace",
            "publicUrl"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "publicUrl": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        },
        "adapter": {
          "type": "object",
          "required": [
            "name",
            "namespace",
            "grpcPort"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "grpcPort": {
              "type": "integer"
            },
            "httpPort": {
              "type": "integer"
            }
          }
        },
        "keycloak": {
          "type": "object",
          "required": [
            "issuer",
            "serviceName",
            "namespace",
            "port",
            "realm",
            "mcpAudience",
            "jwksPath",
            "tokenPath",
            "gatewayClientId",
            "gatewayClientSecretName",
            "gatewayClientSecretPath"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^https?://"
            },
            "serviceName": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "realm": {
              "type": "string"
            },
            "mcpAudience": {
              "type": "string"
            },
            "jwksPath": {
              "type": "string",
              "pattern": "^/"
            },
            "tokenPath": {
              "type": "string",
              "pattern": "^/"
            },
            "gatewayClientId": {
              "type": "string"
            },
            "gatewayClientSecretName": {
              "type": "string"
            },
            "gatewayClientSecretPath": {
              "type": "string"
            }
          }
        },
        "secrets": {
          "type": "object",
          "required": [
            "clusterSecretStore"
          ],
          "properties": {
            "clusterSecretStore": {
              "type": "string"
            }
          }
        },
        "kmcp": {
          "type": "object",
          "required": [
            "port",
            "path",
            "podLabelKey"
          ],
          "properties": {
            "port": {
              "type": "integer"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "podLabelKey": {
              "type": "string"
            },
            "adapterImage": {
              "type": "string"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "required": [
            "fqdn"
          ],
          "properties": {
            "fqdn": {
              "enum": [
                "none",
                "cilium"
              ]
            }
          }
        },
        "podSecurity": {
          "type": "object",
          "required": [
            "runAsUser"
          ],
          "properties": {
            "runAsUser": {
              "type": "integer",
              "minimum": 1000
            }
          }
        },
        "guardrails": {
          "type": "object",
          "properties": {
            "omitProcessor": {
              "type": "boolean"
            }
          }
        },
        "skipPlaceholderImages": {
          "type": "boolean"
        },
        "localImages": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "@sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "pin": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "An all-zero digest is a bootstrap placeholder; the tool gate rejects it."
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[0-9]+m?$|^[0-9]*\\.[0-9]+$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)$"
        }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "cidr": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        },
        "namespace": {
          "$ref": "#/$defs/dnsLabel",
          "description": "Allow traffic to pods in this namespace on the port."
        },
        "fqdn": {
          "type": "string",
          "pattern": "^(\\*\\.)?([a-z0-9-]+\\.)+[a-z]{2,}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "enum": [
            "TCP",
            "UDP"
          ],
          "default": "TCP"
        }
      },
      "oneOf": [
        {
          "required": [
            "cidr"
          ]
        },
        {
          "required": [
            "namespace"
          ]
        },
        {
          "required": [
            "fqdn"
          ]
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "riskTier",
        "capability",
        "outputClassification"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "description": "Tool name exactly as the server advertises it, without the virtual-MCP prefix."
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "riskTier": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "high requires approval.mode: required."
        },
        "capability": {
          "enum": [
            "read",
            "write",
            "exfil-capable",
            "destructive"
          ],
          "description": "exfil-capable: can move data out of the organisation's control (web fetch with a URL, email, upload). destructive: irreversible change."
        },
        "outputClassification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "description": "Highest classification the tool's results can contain. Drives taint and the caller's clearance check."
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "required"
              ]
            },
            "approvers": {
              "type": "string",
              "minLength": 1,
              "description": "Identity group whose members may approve. Must be one of the team's approverGroups."
            },
            "allowSelf": {
              "type": "boolean",
              "default": false,
              "description": "Whether the requester may approve their own call. Off by default."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "required"
                  }
                }
              },
              "then": {
                "required": [
                  "approvers"
                ]
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "riskTier": {
                "const": "high"
              }
            }
          },
          "then": {
            "required": [
              "approval"
            ],
            "properties": {
              "approval": {
                "properties": {
                  "mode": {
                    "const": "required"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
